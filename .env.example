# Frontend API target (Vite reads VITE_* variables)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend settings (set in the API process environment, not exposed to the browser)
# Leave DATABASE_URL unset for local SQLite, or set it to a PostgreSQL URL for hosted use.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
EXAMFLOW_DB_PATH=data/examflow.db
EXAMFLOW_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
